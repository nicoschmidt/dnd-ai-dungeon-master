# Configuration of the backend. Copy to `.env` (never committed) and fill in
# what you need; every variable can also be set in the environment instead.

# What pays for the dungeon master: `subscription` (default) runs on your own
# Claude login — `claude /login`, or `claude setup-token` — which this
# application never reads. `api_key` runs on DM_ANTHROPIC_API_KEY.
DM_CREDENTIAL_MODE=

# A Claude Console API key, used only in api_key mode. An ANTHROPIC_API_KEY in
# your shell is deliberately ignored.
DM_ANTHROPIC_API_KEY=

# The model the dungeon master runs on. Default: claude-opus-5.
DM_MODEL=

# The language the dungeon master narrates in. Default: German.
DM_NARRATION_LANGUAGE=

# `agent` (default) or `stand_in`: a dungeon master that only echoes, for
# developing without any credential.
DM_DUNGEON_MASTER=

# Where the built client is served from. Default: client/dist.
DM_CLIENT_DIST=

# The agent's working directory, where Claude Code keeps the session it
# resumes. Default: ~/.dungeon-master/agent.
DM_AGENT_DIR=
